{
  "name": "infraclarity-ai",
  "version": "1.0.0",
  "private": true,
  "description": "InfraClarity AI: Infrastructure Inspection Image Enhancer",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "powershell -Command \"cd backend; ..\\.venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm run test --prefix frontend",
    "test:backend": "powershell -Command \"cd backend; ..\\.venv\\Scripts\\python -m pytest tests/ -v\"",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
